	if lista==[]:
		return []
		
	contador=0
	primeiro=lista[0]
	for z in lista:
		if z== lista[0]:
			contador+=1


	lista= [x for x in lista if x!=lista[0]]
	
	return [(primeiro, contador)] + contar_ocorrencias(lista)
	
