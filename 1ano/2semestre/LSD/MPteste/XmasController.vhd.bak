library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity Christmas_Controller is
    Port (
        CLK    : in  STD_LOGIC;
        SW     : in  STD_LOGIC_VECTOR(1 downto 0);
        HEX0   : out STD_LOGIC_VECTOR(6 downto 0)
    );
end Christmas_Controller;

architecture structural of Christmas_Controller is
    signal program_number : integer range 0 to 3;
begin
    process(SW)
    begin
        case SW is
            when "00" =>
                program_number <= 0;
            when "01" =>
                program_number <= 1;
            when "10" =>
                program_number <= 2;
            when "11" =>
                program_number <= 3;
            when others =>
                program_number <= 0;
        end case;
    end process;

    process(program_number)
    begin
        case program_number is
            when 0 =>
                HEX0 <= "0000001";
            when 1 =>
                HEX0 <= "1001111";
            when 2 =>
                HEX0 <= "0010010";
            when 3 =>
                HEX0 <= "0000110";
            when others =>
                HEX0 <= "1111111";
        end case;
    end process;

end structural;
