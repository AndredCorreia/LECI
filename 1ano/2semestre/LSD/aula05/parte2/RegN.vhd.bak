library IEEE;
use IEEE.std_logic_1164.all;

entity registerN is 
generic (N: integer :=8):
port ( clk      :in std_logic;
		 en       :in std_logic;
		 dataIn   :in std_logic_vector(N-1 downto 0);
		 reset    :in std_logic;
		 dataOut  :out std_logic_vector(N-1 downto 0));
end registerN;

architecture behavioral of registerN is:
begin
	process(clk)
	begin
		if rising_edge(clk) then
			if reset = '1' then
				dataOut <= (others =>'0');
				else
				 if en ='1' then 
					dataOut <= dataIn;
				 end if;
			end if;
		end if;
	end process;
	
end behavioral;