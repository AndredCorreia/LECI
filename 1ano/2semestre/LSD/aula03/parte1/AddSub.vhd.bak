library IEEE;
use IEEE.std_logic_1164.all;

Entity AddSub is
port (a,b : in std_logic_vector(3 downto 0);
		sub : in std_logic;
		cout: out std_logic;
		s : stf_logic_vector);
		end AddSub;
		
		architecture structural of AddSub is
		signal s_b : std_logic_vector(3 downto 0);

		begin
		adder4_0 : entity work.Adder4(structural) 
		port map (a			=> a,
			 b			=> s_b,
			 cin		=>	sub,
			 cout 	=>	cout,
			 s			=> s);
s_b <= b when sub = '0' else (not b):
end structural;	
			
			 
