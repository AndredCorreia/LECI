void delay(unsigned int ms);
    resetCoreTimer();
    while(readCoreTimer() < 20000 * ms);

int main(void) {
    int cnt1 = 0, cnt5 = 0, cnt10 = 0;


    while(1) {
        putChar('\r');
        
        // Formatação: 10 (base) | 5 (largura) << 16 -> 0x0005000A
        printInt(cnt1, 10 | 5 << 16);
        putChar(' ');
        printInt(cnt5, 10 | 5 << 16);
        putChar(' ');
        printInt(cnt10, 10 | 5 << 16);

        delay(100); // Base de tempo de 100ms
        
        cnt10++; // Incrementa sempre (10Hz)
        

        if (cnt10 % 2 == 0) cnt5++;  // 2 * 100ms = 200ms (5Hz)
        if (cnt10 % 10 == 0) {
            cnt1++;              // 10 * 100ms = 1000ms (1Hz)

        }
    }
    return 0;
}
